# Vijigishu Educational Travel - Server Routing & Clean URLs
DirectoryIndex index.html

# Enable Cross-Origin Resource Sharing (CORS) for external crawlers, tools & preview engines
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, HEAD"
  Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization"
  Header set Access-Control-Max-Age "86400"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Clean URL rewrites: if /about requested, serve /about.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Subfolder clean URL rewrites: if /immersion-programs/uae requested, serve /immersion-programs/uae.html
  RewriteCond %{DOCUMENT_ROOT}/immersion-programs/$1.html -f
  RewriteRule ^immersion-programs/([^/]+)/?$ immersion-programs/$1.html [L]
</IfModule>
