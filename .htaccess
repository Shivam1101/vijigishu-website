# ----------------------------------------------------------------------
# 1. Clean Extensionless URLs Rewrite Engine (.html removal)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Explicit clean routes (Overrules directory name conflicts)
  RewriteRule ^gallery/?$ gallery.html [L]
  RewriteRule ^about/?$ about.html [L]
  RewriteRule ^contact/?$ contact.html [L]
  RewriteRule ^leadership-walk/?$ leadership-walk.html [L]
  RewriteRule ^login/?$ login.html [L]
  RewriteRule ^maintenance/?$ maintenance.html [L]

  # Redirect URLs ending with .html to clean extensionless URLs (301 Permanent)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9} /([^/]+/)*([^.]+).html HTTP/
  RewriteRule ^([^/]+/)*([^.]+).html$ /$1$2 [R=301,L]

  # Internally map clean URL to .html file if file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 2. Production Browser Caching Headers (Images, WebP, CSS, JS, Fonts)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & WebP Banners (1 Year Immutable Caching)
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS & JS (1 Year Caching)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Web Fonts (1 Year Caching)
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Enforce Immutable Public Caching for Static Assets
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|css|js|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 3. GZIP / Brotli Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>